# Copy to .env and fill in.
# Hashes of allowed API keys, comma-separated. Generate with: python tools/new_key.py
API_KEY_HASHES=
# Models clients may use (empty = all pulled models)
ALLOWED_MODELS=llama3.1:8b,mistral:7b
# Requests per minute and per key
RATE_LIMIT_PER_MINUTE=60
# Keep false in production: prompts and answers are personal data
LOG_PROMPTS=false
UPSTREAM_TIMEOUT=300
